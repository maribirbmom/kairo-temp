# ---- Database ----
# memory://local = in-memory (data resets on restart; local dev only).
# Production: MongoDB Atlas free tier connection string.
MONGO_URL="memory://local"
DB_NAME="kairo"

# ---- CORS: set to your frontend URL in production (comma-separated), never "*" ----
CORS_ORIGINS="http://localhost:3000"

# ---- LLM (free tier): https://console.groq.com/keys ----
GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-120b

# ---- Google sign-in: OAuth client ID (Web application) from Google Cloud Console ----
GOOGLE_CLIENT_ID=
# Long random string. Keeps users signed in across restarts. Generate: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=

# ---- Local testing ONLY. Leave unset/false in production. ----
# DEV_AUTH=true

# ---- Per-user daily limits & upload cap (protect the free LLM quota) ----
# LIMIT_UPLOADS_PER_DAY=30
# LIMIT_ANALYSES_PER_DAY=15
# LIMIT_COACH_PER_DAY=60
# MAX_UPLOAD_MB=4   # Vercel rejects request bodies over ~4.5 MB
